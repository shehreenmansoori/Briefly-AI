# Mistral API Key (Required for LLM summarization, extraction, and embeddings)
# Get your key at: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Groq API Key (Required for cloud Whisper transcription - Fast, Free, 0MB RAM)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Sarvam AI (Required for Hinglish audio translation and transcription)
# Get your key at: https://www.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MODEL=saaras:v2.5
